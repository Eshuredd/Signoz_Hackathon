# TraceGuard local configuration template.
# Copy this file to .env at the repository root and fill in local values.
# Empty optional values are treated as unset.
# Real keys must never be committed.

# Local SigNoz API endpoint. Foundry compose exposes SigNoz on localhost:8080.
SIGNOZ_BASE_URL=http://localhost:8080

# SigNoz service-account key used as the SIGNOZ-API-KEY header.
# Put the real key only in your local .env file or secret manager.
SIGNOZ_API_KEY=

# SIGNOZ_TRACE_ID must be a 32-character hexadecimal trace ID.
SIGNOZ_TRACE_ID=

# This run ID should correspond to the telemetry being tested.
TRACEGUARD_AGENT_RUN_ID=

# Self-hosted SigNoz MCP defaults.
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_MCP_HEALTH_URL=http://localhost:8000/livez

# Optional runtime controls.
SIGNOZ_REQUEST_TIMEOUT_SECONDS=10
SIGNOZ_DEBUG=false
