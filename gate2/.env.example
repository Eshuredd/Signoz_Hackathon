# Local SigNoz API endpoint. Foundry compose exposes SigNoz on localhost:8080.
SIGNOZ_BASE_URL=http://localhost:8080

# Create a service account key in SigNoz Settings > Service Accounts.
# The key is sent as the SIGNOZ-API-KEY header. Do not commit real keys.
SIGNOZ_API_KEY=

# Use values printed by gate1/telemetry.py after running a fresh Gate 1A export.
SIGNOZ_TRACE_ID=
TRACEGUARD_AGENT_RUN_ID=

# Optional runtime controls.
SIGNOZ_REQUEST_TIMEOUT_SECONDS=10
SIGNOZ_DEBUG=false

# Self-hosted SigNoz MCP defaults from the SigNoz MCP docs.
# The local Foundry lock inspected for this repo currently has MCP disabled.
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_MCP_HEALTH_URL=http://localhost:8000/livez
