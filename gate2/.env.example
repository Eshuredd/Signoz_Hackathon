# TraceGuard Gate 2 local configuration template.
# Prefer the repository-root .env.example and .env files for runtime use.
# This file is kept as a Gate 2 variable reference only.
# Do not put a real service-account key in this committed example file.

# Local SigNoz API endpoint. Foundry compose exposes SigNoz on localhost:8080.
SIGNOZ_BASE_URL=http://localhost:8080

# Create a service account key in SigNoz Settings > Service Accounts.
# The key is sent as the SIGNOZ-API-KEY header.
# In your private repository-root .env file, set this to the actual key.
SIGNOZ_API_KEY=

# Optional explicit Gate 2 target overrides.
# Normally leave both blank in the repository-root .env. Gate 2 automatically
# uses the latest successful Gate 1 runtime manifest.
# If overriding, provide both values from the same Gate 1 execution.
# SIGNOZ_TRACE_ID is a 32-character trace_id.
SIGNOZ_TRACE_ID=
TRACEGUARD_AGENT_RUN_ID=

# Optional runtime controls.
SIGNOZ_REQUEST_TIMEOUT_SECONDS=10
SIGNOZ_DEBUG=false

# Self-hosted SigNoz MCP defaults from the SigNoz MCP docs.
# casting.yaml enables Foundry MCP; run `foundryctl cast -f casting.yaml`
# and verify `curl -fsS http://localhost:8000/livez` before probing.
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_MCP_HEALTH_URL=http://localhost:8000/livez

# Optional run ID for the valid Gate 2 root-child fixture.
# Leave blank to let relationship_fixture.py generate one.
TRACEGUARD_GATE2_FIXTURE_RUN_ID=
